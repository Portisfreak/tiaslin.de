---
import { getCollection } from 'astro:content';

const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const first = `/${pages[0].id}/`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="refresh" content={`0; url=${first}`} />
  <title>Deliver Us from Evil</title>
  <link rel="canonical" href={first} />
</head>
<body>
  <p style="font-family: Georgia, serif; background:#0d0a07; color:#e8dcc0; text-align:center; padding-top:40px; margin:0;">
    Deliver Us from Evil — redirecting you to the <a href={first} style="color:#c19a5b;">Primer</a>.
  </p>
</body>
</html>
